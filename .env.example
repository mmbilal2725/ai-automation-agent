# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# --- OpenAI ---
OPENAI_API_KEY=sk-...

# --- Meta (Facebook + Instagram) ---
# Found in: developers.facebook.com → Your App → Settings → Basic
META_APP_SECRET=your_app_secret_here
# Found in: developers.facebook.com → Your App → Messenger → Page Access Tokens
META_PAGE_ACCESS_TOKEN=your_page_access_token_here
# A random string you choose; entered in the Meta webhook setup UI
META_VERIFY_TOKEN=choose_a_random_string_here

# --- WhatsApp ---
# Found in: developers.facebook.com → Your App → WhatsApp → API Setup
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token_here

# --- SendGrid (Email) ---
SENDGRID_API_KEY=SG.your_key_here
SENDGRID_FROM_EMAIL=support@yourcompany.com

# --- Database ---
# Local dev: postgresql+asyncpg://postgres:postgres@localhost:5432/agent_db
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/agent_db

# --- App Settings ---
APP_ENV=development
# Confidence below this threshold triggers escalation
ESCALATION_CONFIDENCE_THRESHOLD=0.6
# How the AI presents itself; customise to match your brand voice
BRAND_VOICE_PROMPT=You are a friendly, professional customer service agent. Be concise, helpful, and warm. Never make up information — if you don't know, say so honestly and offer to connect the customer with a team member.
# ChromaDB persistence directory
CHROMA_PERSIST_DIR=./chroma_db
